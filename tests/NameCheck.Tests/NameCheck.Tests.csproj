<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Тесты парсера refs.lua из tools/NameCheck. Проверяют разбор секций на
    синтетических fixture'ах - поэтому CI гоняет их без данных игры
    (дампы и assets.txt в репозиторий не входят, см. .gitignore).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../tools/NameCheck/NameCheck.csproj" />
  </ItemGroup>

</Project>
